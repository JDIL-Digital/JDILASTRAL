# The leading `unset NODE_OPTIONS` strips the deployer-injected flag
# (`--network-family-autoselection-attempt-timeout=…`) that Node 20
# rejects as "not allowed in NODE_OPTIONS", breaking the server before
# it binds a port.
run = "unset NODE_OPTIONS && node .next/standalone/server.js"
entrypoint = "src/app/page.tsx"

[nix]
channel = "stable-23_11"

[deployment]
run = ["sh", "-c", "unset NODE_OPTIONS && npm run build && node .next/standalone/server.js"]
deploymentTarget = "cloudrun"

[env]
NEXT_TELEMETRY_DISABLED = "1"
NODE_ENV = "production"
# Standalone server reads PORT from env — Replit sets it automatically.
# For local dev-container runs, PORT defaults to 3000 inside the server.
PORT = "3000"

[[ports]]
localPort = 3000
externalPort = 80
